@model IT15_MonticalboFinalProj.Models.ViewModels.DashboardStatsViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Analytics"; }

<div class="page-header">
  <div class="breadcrumb"><a href="#">Dashboard</a> / Analytics</div>
  <h2><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Analytics</h2>
</div>

<div class="stat-cards">
  <div class="stat-card" style="--card-color:#4F46E5">
    <div class="card-icon"><i class="bi bi-collection-fill"></i></div>
    <div class="card-value" data-counter="@Model.TotalProjects">0</div>
    <div class="card-label">Total Projects</div>
  </div>
  <div class="stat-card" style="--card-color:#10B981">
    <div class="card-icon"><i class="bi bi-play-circle-fill"></i></div>
    <div class="card-value" data-counter="@Model.ActiveProjects">0</div>
    <div class="card-label">Active</div>
  </div>
  <div class="stat-card" style="--card-color:#F59E0B">
    <div class="card-icon"><i class="bi bi-pause-circle-fill"></i></div>
    <div class="card-value" data-counter="@Model.PendingProjects">0</div>
    <div class="card-label">Pending</div>
  </div>
  <div class="stat-card" style="--card-color:#06B6D4">
    <div class="card-icon"><i class="bi bi-check-circle-fill"></i></div>
    <div class="card-value" data-counter="@Model.CompletedProjects">0</div>
    <div class="card-label">Completed</div>
  </div>
</div>

<div class="analytics-grid">
  <div class="card">
    <div class="card-header"><h5><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Project Distribution</h5></div>
    <div class="card-body"><div class="chart-wrap"><canvas id="pieChart"></canvas></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h5><i class="bi bi-bar-chart me-2 text-primary"></i>Project Status Comparison</h5></div>
    <div class="card-body"><div class="chart-wrap"><canvas id="barChart"></canvas></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h5><i class="bi bi-graph-up me-2 text-primary"></i>Completion Rate</h5></div>
    <div class="card-body">
      <div class="chart-wrap"><canvas id="lineChart"></canvas></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h5><i class="bi bi-people me-2 text-primary"></i>User Statistics</h5></div>
    <div class="card-body">
      <div class="d-flex flex-column gap-3 mt-2">
        <div>
          <div class="d-flex justify-content-between mb-1">
            <span style="font-size:.85rem">Total Users</span>
            <strong>@Model.TotalUsers</strong>
          </div>
          <div class="progress" style="height:8px;border-radius:4px">
            <div class="progress-bar" style="width:100%;background:var(--primary)"></div>
          </div>
        </div>
        <div>
          <div class="d-flex justify-content-between mb-1">
            <span style="font-size:.85rem">Active Projects Rate</span>
            <strong>@(Model.TotalProjects > 0 ? (int)((double)Model.ActiveProjects/Model.TotalProjects*100) : 0)%</strong>
          </div>
          <div class="progress" style="height:8px;border-radius:4px">
            <div class="progress-bar" style="width:@(Model.TotalProjects>0?(int)((double)Model.ActiveProjects/Model.TotalProjects*100):0)%;background:var(--success)"></div>
          </div>
        </div>
        <div>
          <div class="d-flex justify-content-between mb-1">
            <span style="font-size:.85rem">Completion Rate</span>
            <strong>@(Model.TotalProjects > 0 ? (int)((double)Model.CompletedProjects/Model.TotalProjects*100) : 0)%</strong>
          </div>
          <div class="progress" style="height:8px;border-radius:4px">
            <div class="progress-bar" style="width:@(Model.TotalProjects>0?(int)((double)Model.CompletedProjects/Model.TotalProjects*100):0)%;background:var(--secondary)"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
const colors=['#4F46E5','#F59E0B','#10B981'];
const labels=['Active','Pending','Completed'];
const data=[@Model.ActiveProjects,@Model.PendingProjects,@Model.CompletedProjects];
const textColor=getComputedStyle(document.documentElement).getPropertyValue('--text').trim();
const gridColor=getComputedStyle(document.documentElement).getPropertyValue('--border').trim();

new Chart(document.getElementById('pieChart'),{type:'doughnut',
  data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:0,hoverOffset:8}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:textColor,padding:14,font:{size:11}}}}}
});
new Chart(document.getElementById('barChart'),{type:'bar',
  data:{labels,datasets:[{label:'Projects',data,backgroundColor:colors,borderRadius:8,borderWidth:0}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
    scales:{x:{grid:{color:gridColor},ticks:{color:textColor}},y:{grid:{color:gridColor},ticks:{color:textColor,stepSize:1},beginAtZero:true}}}
});
new Chart(document.getElementById('lineChart'),{type:'line',
  data:{labels:['Jan','Feb','Mar','Apr','May','Jun'],
    datasets:[{label:'Projects',data:[1,1,2,3,4,@Model.TotalProjects],
      borderColor:'#4F46E5',backgroundColor:'rgba(79,70,229,.1)',tension:.4,fill:true,pointRadius:4}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:textColor}}},
    scales:{x:{grid:{color:gridColor},ticks:{color:textColor}},y:{grid:{color:gridColor},ticks:{color:textColor,stepSize:1},beginAtZero:true}}}
});
</script>
}
