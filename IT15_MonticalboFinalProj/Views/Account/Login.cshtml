@model IT15_MonticalboFinalProj.Models.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign In"; }

<form asp-action="Login" asp-controller="Account" method="post" id="loginForm" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger small mb-4 py-2 px-3 rounded-3">
            <ul class="mb-0 ps-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li><i class="bi bi-exclamation-circle me-2"></i> @error.ErrorMessage</li>
            }
            </ul>
        </div>
    }

    <div class="mb-3">
        <label asp-for="UsernameOrEmail" class="form-label">Username or Email</label>
        <div class="position-relative">
            <input asp-for="UsernameOrEmail" class="form-control" placeholder="admin / student" autocomplete="username"/>
            <i class="bi bi-person position-absolute end-0 top-50 translate-middle-y me-3 text-muted"></i>
        </div>
        <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="position-relative">
            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" id="pwdInput" autocomplete="current-password"/>
            <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y me-2 text-muted" onclick="togglePwd()">
                <i class="bi bi-eye" id="pwdEye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-4 px-1">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe"/>
            <label class="form-check-label text-white text-opacity-50 small" for="rememberMe">Remember session</label>
        </div>
    </div>

    @if (Configuration.GetValue<bool>("RecaptchaSettings:IsEnabled"))
    {
        <div class="d-flex justify-content-center mb-4">
            <div class="g-recaptcha" data-sitekey="@Configuration["RecaptchaSettings:SiteKey"]" data-theme="dark"></div>
        </div>
    }

    <button type="submit" class="btn btn-primary w-100 py-3 mb-4 shadow-lg" id="loginBtn">
        <span id="loginText">Sign In <i class="bi bi-chevron-right ms-1 small"></i></span>
        <span id="loginSpinner" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Authenticating...</span>
    </button>

</form>

@section Scripts {
@if (Configuration.GetValue<bool>("RecaptchaSettings:IsEnabled"))
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
<script>
function togglePwd(){
    const i=document.getElementById('pwdInput'),e=document.getElementById('pwdEye');
    i.type=i.type==='password'?'text':'password';
    e.className=i.type==='password'?'bi bi-eye':'bi bi-eye-slash';
}
document.getElementById('loginForm').addEventListener('submit',function(){
    document.getElementById('loginBtn').disabled = true;
    document.getElementById('loginText').classList.add('d-none');
    document.getElementById('loginSpinner').classList.remove('d-none');
});
</script>
}
