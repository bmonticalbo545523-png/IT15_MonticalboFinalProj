@model IT15_MonticalboFinalProj.Models.ViewModels.TwoFactorSetupViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Enable 2FA"; }

<div class="text-center mb-4">
    <h4 class="fw-bold">Security Setup</h4>
    <p class="text-white-50 small">Protect your administrative account with Two-Factor Authentication.</p>
</div>

<div class="text-center">
    <div class="bg-white p-3 rounded-4 mb-4 d-inline-block mx-auto shadow-lg" style="background: rgba(255,255,255,0.05) !important;">
        <img src="data:image/png;base64,@Model.QrCodeBase64" class="img-fluid rounded-3" style="max-width: 200px;" alt="QR Code"/>
    </div>
</div>

<div class="text-start mb-4">
    <ol class="small text-white-50 ps-3">
        <li>Open your authenticator app (Google Authenticator, Microsoft, etc.)</li>
        <li>Scan the QR code above or enter the key manually: <strong>@Model.SharedKey</strong></li>
        <li>Enter the 6-digit code generated by the app below.</li>
    </ol>
</div>

<form asp-action="Enable2FA" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-4">
        <label class="form-label">Verification Code</label>
        <input asp-for="VerificationCode" class="form-control text-center fs-4 fw-bold tracking-widest" placeholder="000 000" maxlength="6" autocomplete="off"/>
        <span asp-validation-for="VerificationCode" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-3 mb-3 shadow-lg">
        Verify & Activate <i class="bi bi-shield-lock ms-2"></i>
    </button>
</form>

<style>
    .tracking-widest { letter-spacing: 0.2em; }
</style>
