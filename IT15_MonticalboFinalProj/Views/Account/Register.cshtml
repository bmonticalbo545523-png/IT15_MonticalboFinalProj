@model IT15_MonticalboFinalProj.Models.ViewModels.RegisterViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Register"; }

<form asp-action="Register" asp-controller="Account" method="post" class="mt-2">
    @Html.AntiForgeryToken()
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger small mb-4 py-2 px-3 rounded-3">
            <ul class="mb-0 ps-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li><i class="bi bi-exclamation-circle me-2"></i> @error.ErrorMessage</li>
            }
            </ul>
        </div>
    }

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="Juan dela Cruz" required/>
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="name@example.com" type="email" required/>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="choose_username" required/>
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required/>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label">Confirm</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required/>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>

    <input type="hidden" asp-for="Role" value="Student" />

    <div class="my-4 py-2 px-3 rounded-3 small" style="background: rgba(79,70,229,0.1); border: 1px solid rgba(79,70,229,0.2); color: #a5b4fc;">
        <i class="bi bi-info-circle me-2"></i> Only <strong>Student</strong> accounts can be registered publicly. Faculty accounts require Admin approval.
    </div>

    @if (Configuration.GetValue<bool>("RecaptchaSettings:IsEnabled"))
    {
        <div class="d-flex justify-content-center mb-4">
            <div class="g-recaptcha" data-sitekey="@Configuration["RecaptchaSettings:SiteKey"]" data-theme="dark"></div>
        </div>
    }

    <button type="submit" class="btn btn-primary w-100 py-3 mb-4 shadow-lg" id="registerBtn">
        <span id="registerText">Create Student Account <i class="bi bi-arrow-right ms-1 small"></i></span>
        <span id="registerSpinner" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Creating...</span>
    </button>

    <div class="text-center">
        <span class="text-white text-opacity-50 small">Already a member?</span>
        <a asp-controller="Account" asp-action="Login" class="ms-1">Sign In</a>
    </div>
</form>

@section Scripts {
@if (Configuration.GetValue<bool>("RecaptchaSettings:IsEnabled"))
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
<script>
document.getElementById('registerBtn').closest('form').addEventListener('submit', function(e) {
    document.getElementById('registerBtn').disabled = true;
    document.getElementById('registerText').classList.add('d-none');
    document.getElementById('registerSpinner').classList.remove('d-none');
});
</script>
}
