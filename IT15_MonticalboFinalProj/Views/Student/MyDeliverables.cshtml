@model List<IT15_MonticalboFinalProj.Models.ViewModels.ProjectTaskViewModel>
@{ Layout = "_StudentLayout"; ViewData["Title"] = "My Deliverables"; }

<div class="page-header">
  <div class="breadcrumb">Student / Deliverables</div>
  <h2><i class="bi bi-list-check me-2 text-primary"></i>My Deliverables</h2>
</div>

<div class="card mb-4">
  <div class="card-body">
    <table id="deliverablesTable" class="table w-100">
      <thead><tr>
        <th>#</th><th>Research Group</th><th>Deliverable</th><th>Type</th><th>Status</th><th>Due Date</th><th>Actions</th>
      </tr></thead>
      <tbody>
      @foreach(var t in Model)
      {
        <tr class="@(t.IsLocked ? "opacity-50" : "")">
          <td><span class="badge bg-dark">@(t.OrderIndex + 1)</span></td>
          <td><span class="badge bg-secondary">@t.ProjectName</span></td>
          <td>
            <strong>@t.Title</strong>
            @if(!string.IsNullOrEmpty(t.AttachmentFileName))
            {
              <br/><a href="@t.AttachmentPath" target="_blank" class="text-primary small"><i class="bi bi-paperclip"></i> @t.AttachmentFileName</a>
            }
          </td>
          <td><span class="badge bg-light text-dark border">@t.Type</span></td>
          <td>
            @if(t.Status=="Pending"){ <span class="badge bg-secondary">Pending</span> }
            else if(t.Status=="Submitted"){ <span class="badge bg-info">Submitted</span> }
            else if(t.Status=="Under Review"){ <span class="badge bg-primary">Under Review</span> }
            else if(t.Status=="Needs Revision"){ <span class="badge bg-warning text-dark">Needs Revision</span> }
            else if(t.Status=="Approved"){ <span class="badge bg-success">Approved</span> }
            else{ <span class="badge bg-danger">Overdue</span> }
          </td>
          <td style="font-size:.85rem">@(t.DueDate?.ToString("MMM dd, yyyy") ?? "-")</td>
          <td>
            @if(t.IsLocked)
            {
              <button class="btn btn-sm btn-secondary" disabled title="Complete previous deliverables first">
                <i class="bi bi-lock me-1"></i>Locked
              </button>
            }
            else
            {
              <button class="btn btn-sm btn-primary" onclick="viewDeliverable(@t.Id)">
                <i class="bi bi-eye me-1"></i>View & Submit
              </button>
            }
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<!-- View/Submit Modal -->
<div class="modal fade" id="submitModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-file-earmark-arrow-up me-2 text-primary"></i><span id="taskTitle"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row">
            <div class="col-md-7 border-end">
                <h6>Instructions</h6>
                <p id="taskDesc" class="text-muted small"></p>
                
                <div id="attachmentSection" class="mb-3" style="display:none">
                    <h6>Sample / Template File</h6>
                    <a id="sampleAttachment" href="#" target="_blank" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-download me-1"></i><span id="sampleFileName"></span>
                    </a>
                </div>
                
                <hr/>
                
                <h6>Adviser Feedback</h6>
                <div id="commentList" class="mb-3 small" style="max-height:150px; overflow-y:auto">
                    <!-- Comments here -->
                </div>

                <div id="submissionInfo" class="alert alert-info d-none small">
                    <strong>Previous Submission:</strong> <span id="prevSubmitDate"></span><br/>
                    <a id="prevFilePath" href="#" target="_blank" class="btn btn-xs btn-outline-primary mt-2"><i class="bi bi-download me-1"></i><span id="prevFileName">Download</span></a>
                </div>
            </div>
            <div class="col-md-5">
                <h6>Submit Deliverable</h6>
                <form id="submitForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" id="submitTaskId"/>
                    <div class="mb-3">
                        <label class="form-label small">Submission Note</label>
                        <textarea name="note" id="submitNote" class="form-control" rows="3" placeholder="Add a note for your adviser..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Upload File</label>
                        <input type="file" name="file" class="form-control" required/>
                    </div>
                    <button type="button" class="btn btn-primary w-100" onclick="performSubmit()">
                        <i class="bi bi-cloud-arrow-up me-2"></i>Submit for Review
                    </button>
                    <p class="text-muted small mt-2">Note: Submitting will update the status to 'Submitted'.</p>
                </form>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
$('#deliverablesTable').DataTable({ pageLength:10, order:[[0,'asc']] });
var currentTaskId = 0;

function viewDeliverable(id){
    currentTaskId = id;
    fetch('/Student/GetDeliverableDetails/'+id).then(r=>r.json()).then(data=>{
        document.getElementById('taskTitle').textContent = data.title;
        document.getElementById('taskDesc').textContent = data.description || "No specific instructions.";
        document.getElementById('submitTaskId').value = data.id;
        
        // Show sample attachment if available
        if(data.attachmentPath && data.attachmentFileName){
            document.getElementById('attachmentSection').style.display='block';
            document.getElementById('sampleAttachment').href = data.attachmentPath;
            document.getElementById('sampleFileName').textContent = data.attachmentFileName;
        } else {
            document.getElementById('attachmentSection').style.display='none';
        }
        
        var cList = document.getElementById('commentList');
        cList.innerHTML = "";
        if(data.comments.length === 0) cList.innerHTML = "<p class='text-muted small'>No feedback yet.</p>";
        data.comments.forEach(c => {
            cList.innerHTML += `<div class='mb-2 pb-1 border-bottom'>
                <div class='fw-bold' style='font-size:11px'>${c.fullName} <span class='text-muted fw-normal'>- ${c.createdAt}</span></div>
                <div>${c.content}</div>
            </div>`;
        });

        var sInfo = document.getElementById('submissionInfo');
        if(data.submission) {
            sInfo.classList.remove('d-none');
            document.getElementById('prevSubmitDate').textContent = data.submission.submittedAt;
            if(data.submission.filePath){
                document.getElementById('prevFilePath').href = data.submission.filePath;
                document.getElementById('prevFileName').textContent = data.submission.originalFileName || 'Download File';
                document.getElementById('prevFilePath').classList.remove('d-none');
            } else {
                document.getElementById('prevFilePath').classList.add('d-none');
            }
            document.getElementById('submitNote').value = data.submission.submissionNote || "";
        } else {
            sInfo.classList.add('d-none');
            document.getElementById('submitNote').value = "";
        }

        new bootstrap.Modal(document.getElementById('submitModal')).show();
    });
}

function performSubmit(){
    var f = document.getElementById('submitForm');
    if(!f.checkValidity()) { f.reportValidity(); return; }

    var fd = new FormData(f);
    fetch('/Student/SubmitDeliverable', { method:'POST', body:fd }).then(r=>r.json()).then(res=>{
        if(res.success) { showToast(res.message,'success'); setTimeout(()=>location.reload(),1200); } 
        else { showToast(res.message,'danger'); }
    });
}
</script>
}
