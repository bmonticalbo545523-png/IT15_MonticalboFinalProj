@model List<IT15_MonticalboFinalProj.Models.DefenseSchedule>
@{ Layout = "_StudentLayout"; ViewData["Title"] = "Defense Schedule"; }

<div class="page-header">
  <div class="breadcrumb">Student / Defense Schedule</div>
  <h2><i class="bi bi-calendar-check me-2 text-primary"></i>My Defense Schedule</h2>
</div>

@if(Model.Any())
{
  <div class="row g-4">
  @foreach(var d in Model)
  {
    var statusColor = d.Status == "Confirmed" ? "success" : d.Status == "Approved by Adviser" ? "info" : d.Status == "Pending" ? "warning" : d.Status == "Completed" ? "dark" : "danger";
    <div class="col-md-6">
      <div class="card h-100 border-@statusColor">
        <div class="card-header bg-@statusColor text-white">
          <h5 class="mb-0"><i class="bi bi-mortarboard me-2"></i>@d.Project?.ProjectName</h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-6">
              <div class="text-muted small">Date</div>
              <div class="fw-bold">@d.ScheduledDate.ToString("MMMM dd, yyyy")</div>
            </div>
            <div class="col-6">
              <div class="text-muted small">Time</div>
              <div class="fw-bold">@d.StartTime.ToString(@"hh\:mm") - @d.EndTime.ToString(@"hh\:mm")</div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-6">
              <div class="text-muted small">Location</div>
              <div class="fw-bold">@d.Location</div>
            </div>
            <div class="col-6">
              <div class="text-muted small">Adviser</div>
              <div class="fw-bold">@(d.Project?.Adviser?.FullName ?? "-")</div>
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-@statusColor fs-6">@d.Status</span>
            @if(!string.IsNullOrEmpty(d.Remarks))
            {
              <small class="text-muted">@d.Remarks</small>
            }
          </div>
        </div>
      </div>
    </div>
  }
  </div>
}
else
{
  <div class="card">
    <div class="card-body text-center py-5">
      <i class="bi bi-calendar-x fs-1 d-block mb-3 text-muted"></i>
      <h5 class="text-muted">No Defense Scheduled Yet</h5>
      <p class="text-muted">Your defense will appear here once your adviser and admin have scheduled it. Make sure all your deliverables are approved first.</p>
    </div>
  </div>
}
