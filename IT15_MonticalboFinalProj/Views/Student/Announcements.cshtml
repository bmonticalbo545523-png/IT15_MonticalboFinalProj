@model List<IT15_MonticalboFinalProj.Models.Announcement>
@{ Layout = "_StudentLayout"; ViewData["Title"] = "Announcements"; }

<div class="page-header">
  <div class="breadcrumb">Student / Announcements</div>
  <h2><i class="bi bi-megaphone-fill me-2 text-primary"></i>Research Announcements</h2>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach(var a in Model)
            {
                <div class="list-group-item p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-primary mb-2">@a.Project?.ProjectName</span>
                            <h5 class="mb-1">@a.Title</h5>
                        </div>
                        <small class="text-muted">@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    <p class="mb-2 text-muted">@a.Content</p>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <i class="bi bi-person-circle"></i>
                        Posted by @(a.Author?.FullName ?? "System")
                    </div>
                </div>
            }
            @if(!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-bell-slash fs-1 d-block mb-3"></i>
                    No announcements at this time.
                </div>
            }
        </div>
    </div>
</div>
