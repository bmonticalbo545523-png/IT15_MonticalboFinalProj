@model IT15_MonticalboFinalProj.Models.ApplicationUser
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Complete Your Profile"; }

<div class="auth-card" style="max-width:600px">
  <div class="auth-header">
    <div class="auth-logo"><i class="bi bi-person-badge-fill"></i></div>
    <h3>Welcome to ResearchHub</h3>
    <p>Please complete your profile to get started.</p>
  </div>

  <form asp-action="Setup" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Full Name</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-person"></i></span>
          <input asp-for="FullName" class="form-control" placeholder="Full Name" required />
        </div>
      </div>
      <div class="col-md-6">
        <label class="form-label">Profile Photo</label>
        <input type="file" name="photo" class="form-control" accept="image/*" />
      </div>

      @if (User.IsInRole("ResearchAdviser"))
      {
        <div class="col-12">
          <label class="form-label">Specialization</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-mortarboard"></i></span>
            <input asp-for="Specialization" class="form-control" placeholder="e.g. Data Science, Machine Learning" required />
          </div>
        </div>
      }

      @if (User.IsInRole("Student"))
      {
        <div class="col-md-6">
          <label class="form-label">Student ID Number</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-card-text"></i></span>
            <input asp-for="StudentIdNumber" class="form-control" placeholder="e.g. 2024-0001" required />
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Program / Course</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-book"></i></span>
            <input asp-for="ProgramOrCourse" class="form-control" placeholder="e.g. BSCS" required />
          </div>
        </div>
      }

      <div class="col-12">
        <label class="form-label">Bio / Professional Summary</label>
        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us a bit about yourself..."></textarea>
      </div>
    </div>

    <div class="mt-4">
      <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="bi bi-check-circle me-2"></i>Complete Setup
      </button>
    </div>
  </form>
</div>
