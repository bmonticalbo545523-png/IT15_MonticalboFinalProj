@model List<IT15_MonticalboFinalProj.Models.Announcement>
@{ Layout = "_ResearchAdviserLayout"; ViewData["Title"] = "Manage Announcements"; }
@{
    var project = ViewBag.Project as IT15_MonticalboFinalProj.Models.Project;
}

<div class="page-header d-flex align-items-center justify-content-between">
  <div>
    <div class="breadcrumb">
      <a asp-action="MyResearchGroups">My Groups</a> / @(project?.ProjectName) / Announcements
    </div>
    <h2><i class="bi bi-megaphone me-2 text-primary"></i>Announcements: @(project?.ProjectName)</h2>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
    <i class="bi bi-plus-lg me-1"></i>New Announcement
  </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach(var a in Model)
            {
                <div class="list-group-item p-4">
                    <div class="d-flex justify-content-between">
                        <h5 class="mb-1 text-primary">@a.Title</h5>
                        <small class="text-muted">@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    <p class="mb-1 text-muted">@a.Content</p>
                    <small class="text-muted">Posted by @(a.Author?.FullName ?? "System")</small>
                </div>
            }
            @if(!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    No announcements posted for this group yet.
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">New Announcement</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@project?.Id"/>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input name="title" class="form-control" required placeholder="e.g. Welcome to the Research Group"/>
          </div>
          <div class="mb-3">
            <label class="form-label">Content</label>
            <textarea name="content" class="form-control" rows="5" required placeholder="Write your message here..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitAdd()">Post Announcement</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
<script>
function submitAdd(){
    var f=document.getElementById('addForm');if(!f.checkValidity()){f.reportValidity();return;}
    ajaxPost('/ResearchAdviser/AddAnnouncement','addForm',function(){ location.reload(); });
}
</script>
}
