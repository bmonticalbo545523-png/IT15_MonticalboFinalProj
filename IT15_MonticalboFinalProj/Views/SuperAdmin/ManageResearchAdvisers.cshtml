@model List<IT15_MonticalboFinalProj.Models.ViewModels.AdminUserViewModel>
@{ Layout = "_SuperAdminLayout"; ViewData["Title"] = "Manage Research Advisers"; }
@{
    var archivedAdvisers = ViewBag.ArchivedAdvisers as List<IT15_MonticalboFinalProj.Models.ViewModels.AdminUserViewModel> ?? new();
    var addUrl = Url.Action("AddResearchAdviser","SuperAdmin");
    var editUrl = Url.Action("EditResearchAdviser","SuperAdmin");
    var archiveUrl = Url.Action("ArchiveResearchAdviser","SuperAdmin");
    var restoreUrl = Url.Action("RestoreResearchAdviser","SuperAdmin");
    var detailsUrl = Url.Action("GetAdviserDetails","SuperAdmin");
}

<div class="page-header d-flex align-items-center justify-content-between">
  <div>
    <div class="breadcrumb"><a href="#">Dashboard</a> / Research Advisers</div>
    <h2><i class="bi bi-person-workspace me-2 text-primary"></i>Manage Research Advisers</h2>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
    <i class="bi bi-plus-lg me-1"></i>Add Research Adviser
  </button>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-person-check me-2 text-success"></i>Active Research Advisers</h6>
    <table id="advisersTable" class="table w-100">
      <thead><tr>
        <th>#</th><th>Full Name</th><th>Email</th><th>Username</th>
        <th>Status</th><th>Created</th><th>Actions</th>
      </tr></thead>
      <tbody>
      @{ int i=1; }
      @foreach(var adviser in Model)
      {
        <tr>
          <td>@(i++)</td>
          <td><strong>@adviser.FullName</strong></td>
          <td><span style="color:var(--text2)">@adviser.Email</span></td>
          <td><code style="color:var(--primary-light)">@adviser.Username</code></td>
          <td>
            <span class="badge-status @(adviser.Status=="Active"?"badge-active":"badge-inactive")">
              <i class="bi @(adviser.Status=="Active"?"bi-circle-fill":"bi-circle") " style="font-size:.5rem"></i>
              @adviser.Status
            </span>
          </td>
          <td style="font-size:.8rem;color:var(--muted)">@adviser.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
          <td>
            <div class="d-flex gap-1">
              <button class="btn-icon bg-primary text-white" title="View" onclick="viewAdviser('@adviser.Id')"><i class="bi bi-eye"></i></button>
              <button class="btn-icon" style="background:rgba(79,70,229,.15);color:var(--primary)" title="Edit"
                onclick="editAdviser('@adviser.Id','@adviser.FullName','@adviser.Email','@adviser.Username','@adviser.Status')"><i class="bi bi-pencil"></i></button>
              <button class="btn-icon" style="background:rgba(245,158,11,.15);color:#d97706" title="Archive"
                onclick="confirmArchive('@adviser.Id','@adviser.FullName')"><i class="bi bi-archive"></i></button>
            </div>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@if(archivedAdvisers.Any())
{
<div class="card">
  <div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-archive me-2 text-warning"></i>Archived Research Advisers
      <span class="badge bg-warning text-dark ms-1">@archivedAdvisers.Count</span></h6>
    <table id="archivedAdvisersTable" class="table w-100">
      <thead><tr>
        <th>#</th><th>Full Name</th><th>Email</th><th>Archived On</th><th>Actions</th>
      </tr></thead>
      <tbody>
      @{ int j=1; }
      @foreach(var adviser in archivedAdvisers)
      {
        <tr>
          <td>@(j++)</td>
          <td><strong>@adviser.FullName</strong></td>
          <td>@adviser.Email</td>
          <td style="font-size:.8rem;color:var(--muted)">@(adviser.ArchivedAt?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")</td>
          <td>
            <button class="btn-icon" style="background:rgba(16,185,129,.15);color:#059669" title="Restore"
              onclick="confirmRestore('@adviser.Id','@adviser.FullName')">
              <i class="bi bi-arrow-counterclockwise"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>
}

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-plus me-2 text-primary"></i>Add Research Adviser</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3"><label class="form-label">Full Name</label>
            <input name="FullName" class="form-control" required placeholder="Full name"/></div>
          <div class="mb-3"><label class="form-label">Email</label>
            <input name="Email" type="email" class="form-control" required placeholder="email@researchhub.com"/></div>
          <div class="mb-3"><label class="form-label">Username</label>
            <input name="Username" class="form-control" required placeholder="username"/></div>
          <div class="mb-3"><label class="form-label">Password</label>
            <input name="Password" type="password" class="form-control" required placeholder="Min 6 chars, A-Z 0-9 symbol"/></div>
          <input type="hidden" name="Role" value="ResearchAdviser"/>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitAdd()"><i class="bi bi-check-lg me-1"></i>Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Research Adviser</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <input type="hidden" name="Id" id="editId"/>
          <div class="mb-3"><label class="form-label">Full Name</label>
            <input name="FullName" id="editFullName" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">Email</label>
            <input name="Email" id="editEmail" type="email" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">Username</label>
            <input name="Username" id="editUsername" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">New Password <small class="text-muted">(leave blank to keep)</small></label>
            <input name="Password" type="password" class="form-control" placeholder="Leave blank to keep current"/></div>
          <div class="mb-3"><label class="form-label">Status</label>
            <select name="Status" id="editStatus" class="form-select">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
          <input type="hidden" name="Role" value="ResearchAdviser"/>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitEdit()"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="viewModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-workspace me-2 text-primary"></i>Research Adviser Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="viewBody">Loading…</div>
      <div class="modal-footer"><button class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<div class="modal fade" id="archiveModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" style="color:#d97706"><i class="bi bi-archive me-2"></i>Archive</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><p>Archive <strong id="archiveName"></strong>?</p><input type="hidden" id="archiveId"/></div>
    <div class="modal-footer">
      <button class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
      <button class="btn btn-warning text-white" onclick="submitArchive()"><i class="bi bi-archive me-1"></i>Archive</button>
    </div>
  </div></div>
</div>

<div class="modal fade" id="restoreModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title text-success"><i class="bi bi-arrow-counterclockwise me-2"></i>Restore</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><p>Restore <strong id="restoreName"></strong>?</p><input type="hidden" id="restoreId"/></div>
    <div class="modal-footer">
      <button class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
      <button class="btn btn-success" onclick="submitRestore()"><i class="bi bi-arrow-counterclockwise me-1"></i>Restore</button>
    </div>
  </div></div>
</div>

@section Scripts {
<script>
var _addUrl='@addUrl', _editUrl='@editUrl', _archiveUrl='@archiveUrl', _restoreUrl='@restoreUrl', _detailsUrl='@detailsUrl';

$('#advisersTable').DataTable({
  dom:"<'row'<'col-sm-6'l><'col-sm-6'f>><'row'<'col-12'B>><'row'<'col-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
  buttons:['excelHtml5','csvHtml5','print'],
  pageLength:10, responsive:true
});
if(document.getElementById('archivedAdvisersTable')){
  $('#archivedAdvisersTable').DataTable({ pageLength:5 });
}
var token = document.querySelector('[name=__RequestVerificationToken]').value;

function submitAdd(){
  var f=document.getElementById('addForm');
  if(!f.checkValidity()){f.reportValidity();return;}
  ajaxPost(_addUrl,'addForm',function(){bootstrap.Modal.getInstance(document.getElementById('addModal')).hide();});
}
function editAdviser(id,fn,em,un,st){
  document.getElementById('editId').value=id;
  document.getElementById('editFullName').value=fn;
  document.getElementById('editEmail').value=em;
  document.getElementById('editUsername').value=un;
  document.getElementById('editStatus').value=st;
  new bootstrap.Modal(document.getElementById('editModal')).show();
}
function submitEdit(){
  ajaxPost(_editUrl,'editForm',function(){bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();});
}
function viewAdviser(id){
  fetch(_detailsUrl+'?id='+id).then(function(r){return r.json();}).then(function(d){
    document.getElementById('viewBody').innerHTML=
      '<div class="d-flex align-items-center gap-3 mb-3">'+
      '<div class="user-avatar" style="width:48px;height:48px;font-size:1.1rem">'+d.fullName.charAt(0)+'</div>'+
      '<div><div class="fw-700" style="font-size:1rem">'+d.fullName+'</div><div class="text-muted small">Research Adviser</div></div></div>'+
      '<table class="table table-sm" style="color:var(--text)">'+
      '<tr><td class="text-muted" style="width:35%">Username</td><td><code>'+d.username+'</code></td></tr>'+
      '<tr><td class="text-muted">Email</td><td>'+d.email+'</td></tr>'+
      '<tr><td class="text-muted">Status</td><td><span class="badge-status '+(d.status==='Active'?'badge-active':'badge-inactive')+'">'+d.status+'</span></td></tr>'+
      '<tr><td class="text-muted">Joined</td><td>'+new Date(d.createdAt).toLocaleDateString()+'</td></tr></table>';
    new bootstrap.Modal(document.getElementById('viewModal')).show();
  });
}
function confirmArchive(id,name){
  document.getElementById('archiveId').value=id;document.getElementById('archiveName').textContent=name;
  new bootstrap.Modal(document.getElementById('archiveModal')).show();
}
function submitArchive(){
  var id=document.getElementById('archiveId').value;
  var fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',token);
  fetch(_archiveUrl,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
    if(res.success){showToast(res.message,'success');setTimeout(function(){location.reload();},1200);}
    else showToast(res.message,'danger');
    bootstrap.Modal.getInstance(document.getElementById('archiveModal')).hide();
  });
}
function confirmRestore(id,name){
  document.getElementById('restoreId').value=id;document.getElementById('restoreName').textContent=name;
  new bootstrap.Modal(document.getElementById('restoreModal')).show();
}
function submitRestore(){
  var id=document.getElementById('restoreId').value;
  var fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',token);
  fetch(_restoreUrl,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
    if(res.success){showToast(res.message,'success');setTimeout(function(){location.reload();},1200);}
    else showToast(res.message,'danger');
    bootstrap.Modal.getInstance(document.getElementById('restoreModal')).hide();
  });
}
</script>
}
