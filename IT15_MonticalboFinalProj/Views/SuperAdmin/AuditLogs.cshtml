@model List<IT15_MonticalboFinalProj.Models.AuditLog>
@{ Layout = "_SuperAdminLayout"; ViewData["Title"] = "Audit Logs"; }

<div class="page-header">
  <div class="breadcrumb"><a href="#">Dashboard</a> / Audit Logs</div>
  <h2><i class="bi bi-journal-text me-2 text-primary"></i>Audit Logs</h2>
  <p>Complete history of system actions — @Model.Count entries</p>
</div>

<div class="card">
  <div class="card-body">
    <table id="logsTable" class="table w-100">
      <thead><tr>
        <th>#</th><th>Timestamp</th><th>User</th><th>Action</th><th>IP Address</th>
      </tr></thead>
      <tbody>
      @{ int i=1; }
      @foreach(var log in Model)
      {
        <tr class="log-row">
          <td>@(i++)</td>
          <td style="font-size:.78rem;white-space:nowrap;color:var(--muted)">
            @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
          </td>
          <td>
            <span style="font-size:.82rem;color:var(--text2)">@(log.User?.UserName ?? "System")</span>
          </td>
          <td style="font-size:.85rem">@log.Action</td>
          <td style="font-family:monospace;font-size:.75rem;color:var(--muted)">
            @(log.IpAddress ?? "—")
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script>
$('#logsTable').DataTable({
  dom:"<'row'<'col-sm-6'l><'col-sm-6'f>><'row'<'col-12'B>><'row'<'col-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
  buttons:['excelHtml5','csvHtml5','print'],
  order:[[1,'desc']],pageLength:25
});
</script>
}
