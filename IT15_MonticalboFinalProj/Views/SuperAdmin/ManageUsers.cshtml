@model List<IT15_MonticalboFinalProj.Models.ViewModels.AdminUserViewModel>
@{ Layout = "_SuperAdminLayout"; ViewData["Title"] = "Manage Users"; }
@{
    var addUrl = Url.Action("AddUser", "SuperAdmin");
    var editUrl = Url.Action("EditUser", "SuperAdmin");
    var archiveUrl = Url.Action("ArchiveUser", "SuperAdmin");
}

<div class="page-header d-flex align-items-center justify-content-between">
  <div>
    <div class="breadcrumb"><a href="#">Dashboard</a> / Users</div>
    <h2><i class="bi bi-people-fill me-2 text-primary"></i>Manage Users</h2>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
    <i class="bi bi-person-plus-fill me-1"></i>Add User
  </button>
</div>

<div class="row g-4">
  <!-- Department Sidebar -->
  <div class="col-lg-3">
    <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
      <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
        <h6 class="fw-bold mb-0 text-primary uppercase tracking-wider" style="font-size: .75rem;">Departments</h6>
      </div>
      <div class="card-body p-3">
        <div class="list-group list-group-flush gap-1">
          <button class="list-group-item list-group-item-action border-0 rounded-3 dept-filter active" data-dept="all">
            <div class="d-flex align-items-center justify-content-between w-100">
              <div class="d-flex align-items-center gap-3">
                <div class="dept-icon bg-primary text-white"><i class="bi bi-grid-fill"></i></div>
                <span>All Departments</span>
              </div>
              <span class="badge rounded-pill bg-light text-dark">@Model.Count</span>
            </div>
          </button>

          @{ 
            var departments = ViewBag.Departments as List<IT15_MonticalboFinalProj.Models.Department> ?? new(); 
          }
          @foreach(var d in departments)
          {
            var count = Model.Count(u => u.DepartmentId == d.Id);
            <button class="list-group-item list-group-item-action border-0 rounded-3 dept-filter" data-dept="@d.Name">
              <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-3">
                  <div class="dept-icon"><i class="bi bi-building"></i></div>
                  <span>@d.Name</span>
                </div>
                <span class="badge rounded-pill bg-light text-dark">@count</span>
              </div>
            </button>
          }

          @{ var noDeptCount = Model.Count(u => u.DepartmentId == null || u.DepartmentId == 0); }
          <button class="list-group-item list-group-item-action border-0 rounded-3 dept-filter" data-dept="No Department">
            <div class="d-flex align-items-center justify-content-between w-100">
              <div class="d-flex align-items-center gap-3">
                <div class="dept-icon"><i class="bi bi-person-badge"></i></div>
                <span>System Accounts</span>
              </div>
              <span class="badge rounded-pill bg-light text-dark">@noDeptCount</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Content -->
  <div class="col-lg-9">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="px-4 pt-4 pb-3 border-bottom d-flex align-items-center justify-content-between bg-light rounded-top">
          <h6 class="fw-bold mb-0" id="currentDeptLabel"><i class="bi bi-people-fill me-2 text-primary"></i>All Users</h6>
          <span class="text-muted small" id="userCountLabel">Showing all @Model.Count users</span>
        </div>
        <div class="p-4">
          <table id="usersTable" class="table w-100 mt-2">
            <thead><tr>
              <th>#</th><th>Name</th><th>Email</th><th>Role</th>
              <th class="d-none">DeptHidden</th><th>Department</th><th>Status</th><th>Actions</th>
            </tr></thead>
            <tbody>
            @{ int i=1; }
            @foreach(var user in Model)
            {
              <tr>
                <td>@(i++)</td>
                <td><strong>@user.FullName</strong><br/><small class="text-muted">@@@user.Username</small></td>
                <td><span style="color:var(--text2)">@user.Email</span></td>
                <td>
                  @if(user.Role == "SuperAdmin"){ <span class="badge bg-danger">SuperAdmin</span> }
                  else if(user.Role == "Administrator"){ <span class="badge bg-primary">Admin</span> }
                  else if(user.Role == "ResearchAdviser"){ <span class="badge bg-info">Adviser</span> }
                  else { <span class="badge bg-secondary">Student</span> }
                </td>
                <td class="d-none">@(string.IsNullOrEmpty(user.DepartmentName) || user.DepartmentName == "No Department" ? "No Department" : user.DepartmentName)</td>
                <td><span class="text-muted">@user.DepartmentName</span></td>
                <td>
                  <span class="badge-status @(user.Status=="Active"?"badge-active":"badge-inactive")">
                    <i class="bi @(user.Status=="Active"?"bi-circle-fill":"bi-circle") " style="font-size:.5rem"></i>
                    @user.Status
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    @{
                        var mappedRole = user.Role switch {
                            "SuperAdmin" => "SuperAdmin",
                            "Administrator" => "Admin",
                            "ResearchAdviser" => "Adviser",
                            _ => "Student"
                        };
                        var isRestricted = user.Role == "Student" || user.Role == "ResearchAdviser";
                    }
                    
                    @if (isRestricted)
                    {
                      <button class="btn-icon" style="background:rgba(100,116,139,.1);color:var(--muted)" title="View Only (Managed by Dept Admin)"
                        onclick="editUser('@user.Id','@user.FullName','@user.Email','@user.Username','@mappedRole','@user.Status','@user.DepartmentId', true)">
                        <i class="bi bi-eye"></i>
                      </button>
                    }
                    else
                    {
                      <button class="btn-icon" style="background:rgba(79,70,229,.15);color:var(--primary)" title="Edit"
                        onclick="editUser('@user.Id','@user.FullName','@user.Email','@user.Username','@mappedRole','@user.Status','@user.DepartmentId', false)"><i class="bi bi-pencil"></i></button>
                      <button class="btn-icon" style="background:rgba(239,68,68,.15);color:#ef4444" title="Archive"
                          onclick="confirmArchive('@user.Id','@user.FullName')"><i class="bi bi-archive"></i></button>
                    }
                  </div>
                </td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dept-icon {
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--bg2); display: flex; align-items: center; justify-content: center;
    color: var(--text2); font-size: 1rem; transition: all var(--transition);
  }
  .dept-filter.active .dept-icon { background: rgba(255,255,255,0.2); color: #fff; }
  .dept-filter:not(.active):hover .dept-icon { background: var(--border); color: var(--primary); }
  .list-group-item-action.active { background-color: var(--primary); border-color: var(--primary); }
  .uppercase { text-transform: uppercase; }
  .tracking-wider { letter-spacing: 0.05em; }
</style>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Add New User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3"><label class="form-label">Full Name</label>
            <input name="FullName" class="form-control" required placeholder="John Doe"/></div>
          <div class="mb-3"><label class="form-label">Email Address</label>
            <input name="Email" type="email" class="form-control" required placeholder="john@example.com"/></div>
          <div class="mb-3"><label class="form-label">Username</label>
            <input name="Username" class="form-control" required placeholder="username"/></div>
          <div class="mb-3"><label class="form-label">Role</label>
            <select name="Role" class="form-select">
              <option value="Admin" selected>Admin (Dept)</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Department</label>
            <select name="DepartmentId" class="form-select" required>
              <option value="" disabled selected>Select Department</option>
              @foreach(var d in departments) {
                <option value="@d.Id">@d.Name</option>
              }
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Password</label>
            <input name="Password" type="password" class="form-control" required placeholder="••••••••"/></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitAdd()"><i class="bi bi-check-lg me-1"></i>Create User</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editForm">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <input type="hidden" name="Id" id="editId"/>
          <div class="mb-3"><label class="form-label">Full Name</label>
            <input name="FullName" id="editFullName" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">Email Address</label>
            <input name="Email" id="editEmail" type="email" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">Username</label>
            <input name="Username" id="editUsername" class="form-control" required/></div>
          <div class="mb-3"><label class="form-label">Role</label>
            <select name="Role" id="editRole" class="form-select">
              <option value="Admin">Admin (Dept)</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Department</label>
            <select name="DepartmentId" id="editDepartmentId" class="form-select" required>
              @foreach(var d in departments) {
                <option value="@d.Id">@d.Name</option>
              }
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Status</label>
            <select name="Status" id="editStatus" class="form-select">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">New Password <small class="text-muted">(leave blank to keep)</small></label>
            <input name="Password" type="password" class="form-control" placeholder="••••••••"/></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitEdit()"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="archiveModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title text-danger"><i class="bi bi-archive me-2"></i>Archive</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><p>Set <strong id="archiveUserName"></strong> as inactive?</p><input type="hidden" id="archiveUserId"/></div>
    <div class="modal-footer">
      <button class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
      <button class="btn btn-danger" onclick="submitArchive()"><i class="bi bi-archive me-1"></i>Confirm</button>
    </div>
  </div></div>
</div>

@section Scripts {
<script>
var _addUrl='@addUrl', _editUrl='@editUrl', _archiveUrl='@archiveUrl';

var table = $('#usersTable').DataTable({ 
  pageLength: 10, 
  responsive: true,
  columnDefs: [
    { targets: 4, visible: false } // Hidden column for filtering
  ]
});

var token = document.querySelector('[name=__RequestVerificationToken]').value;

// Department Filtering Logic
$('.dept-filter').on('click', function() {
  $('.dept-filter').removeClass('active');
  $(this).addClass('active');

  var dept = $(this).data('dept');
  var label = $(this).find('span').first().text();
  var count = $(this).find('.badge').text();

  if(dept === 'all') {
    table.column(4).search('').draw();
    $('#currentDeptLabel').html('<i class="bi bi-people-fill me-2 text-primary"></i>All Users');
    $('#userCountLabel').text('Showing all ' + count + ' users');
  } else {
    // Exact match for department name
    table.column(4).search('^' + dept + '$', true, false).draw();
    $('#currentDeptLabel').html('<i class="bi bi-building me-2 text-primary"></i>' + label);
    $('#userCountLabel').text('Showing ' + count + ' users in this department');
  }
});

function submitAdd(){
  var f=document.getElementById('addForm');
  if(!f.checkValidity()){f.reportValidity();return;}
  ajaxPost(_addUrl,'addForm',function(){bootstrap.Modal.getInstance(document.getElementById('addModal')).hide();});
}
function editUser(id,fn,em,un,rl,st,deptId, readOnly = false){
  document.getElementById('editId').value=id;
  document.getElementById('editFullName').value=fn;
  document.getElementById('editEmail').value=em;
  document.getElementById('editUsername').value=un;
  document.getElementById('editRole').value=rl;
  document.getElementById('editStatus').value=st;
  document.getElementById('editDepartmentId').value=deptId;
  
  // Handle Read-Only mode for Students/Advisers
  var form = document.getElementById('editForm');
  var inputs = form.querySelectorAll('input, select');
  var saveBtn = form.closest('.modal-content').querySelector('.modal-footer .btn-primary');
  var modalTitle = form.closest('.modal-content').querySelector('.modal-title');

  if(readOnly) {
    inputs.forEach(i => i.disabled = true);
    if(saveBtn) saveBtn.classList.add('d-none');
    modalTitle.innerHTML = '<i class="bi bi-eye me-2 text-primary"></i>View User Details';
  } else {
    inputs.forEach(i => i.disabled = false);
    if(saveBtn) saveBtn.classList.remove('d-none');
    modalTitle.innerHTML = '<i class="bi bi-pencil-square me-2 text-primary"></i>Edit User';
  }

  new bootstrap.Modal(document.getElementById('editModal')).show();
}
function submitEdit(){
  ajaxPost(_editUrl,'editForm',function(){bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();});
}
function confirmArchive(id,name){
  document.getElementById('archiveUserId').value=id;document.getElementById('archiveUserName').textContent=name;
  new bootstrap.Modal(document.getElementById('archiveModal')).show();
}
function submitArchive(){
  var id=document.getElementById('archiveUserId').value;
  var fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',token);
  fetch(_archiveUrl,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
    if(res.success){showToast(res.message,'success');setTimeout(function(){location.reload();},1200);}
    else showToast(res.message,'danger');
    bootstrap.Modal.getInstance(document.getElementById('archiveModal')).hide();
  });
}
</script>
}
